    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.0",
    "vitest": "^3.2.3"
  },
  "dependencies": {
    "@mysten/sui": "^1.30.5",
    "commander": "^14.0.0",
    "tsup": "^8.5.0"
